{
  "name": "pos-pharmacy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "test": "pnpm -r --parallel test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test",
    "db:keys": "test -s supabase/signing_keys.json || (echo '[]' > supabase/signing_keys.json && (supabase gen signing-key --algorithm ES256 --append || true))",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
