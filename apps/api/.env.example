# Local Supabase (`supabase start`, ports from supabase/config.toml)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
PORT=3101
# Server-only. `supabase status` prints the local one. Never expose it to a client.
SUPABASE_SECRET_KEY=
# Where the invitation email's link lands (the POS app, once it exists).
INVITE_REDIRECT_URL=
